    "subcategoria": "Una carta sin abrir",
    "poema": {
        "titulo": "El Misterio de las Líneas",
        "texto": "Un_te-sor_duer-me_ahí\nen_sus_plie-gues_es-con-de_vie-jos_sue-ños.\nSil-be_el_vien-to_sin_fin\nque_lle-va_le-jos_a_to-dos_los_due-ños.\nMis_o-jos_quie-ren_ver\nmas_la_cau-te-la_es_más_fuer-te_y_pre-cia-da.\n¿Qué_de-be-rá_es-con-der\npa-ra_que_nun-ca_sea_su_suer-te_a-cla-ra-da?",
        "tipo": "Madrigal",
        "palabra_clave_ingresada": "Una carta sin abrir"
    }
}