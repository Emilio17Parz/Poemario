{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["subcategoria", "poema"],
  "properties": {
    "subcategoria": { "type": "string" },
    "poema": {
      "type": "object",
      "required": ["texto", "tipo", "palabra_clave_ingresada"],
      "properties": {
        "texto": { "type": "string" },
        "tipo": { "type": "string" },
        "palabra_clave_ingresada": { "type": "string" }
      }
    }
  }
}
